{
  "name": "steam-achiever",
  "version": "1.1.3",
  "description": "Desktop app to view and manually unlock or lock Steam achievements for games you own",
  "author": "Daniel Spasov",
  "license": "ISC",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/DanielSpasov/steam-achiever.git"
  },
  "main": "dist/main.js",
  "scripts": {
    "build:main": "tsc -p tsconfig.json",
    "typecheck:renderer": "tsc -p renderer/tsconfig.json",
    "bundle:renderer": "esbuild renderer/ui/main.ts --bundle --format=iife --target=es2020 --outfile=renderer/app.js",
    "build": "npm run build:main && npm run typecheck:renderer && npm run bundle:renderer",
    "watch": "tsc -p tsconfig.json --watch",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder",
    "manual": "node scripts/manual-test.js",
    "release:dry": "semantic-release --dry-run --no-ci"
  },
  "dependencies": {
    "electron-updater": "^6.6.2",
    "steamworks.js": "^0.4.0"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^11.0.5",
    "@semantic-release/npm": "^12.0.2",
    "@types/node": "^26.4.1",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "semantic-release": "^24.2.9",
    "typescript": "^5.9.3"
  },
  "build": {
    "appId": "com.danielspasov.steamachiever",
    "productName": "Steam Achiever",
    "directories": {
      "output": "release"
    },
    "afterPack": "scripts/adhoc-sign.js",
    "files": [
      "dist",
      "renderer/index.html",
      "renderer/styles.css",
      "renderer/app.js"
    ],
    "asarUnpack": [
      "dist/worker.js",
      "node_modules/steamworks.js/**"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.utilities",
      "artifactName": "Steam-Achiever-${version}-${arch}.${ext}"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "Steam-Achiever-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility",
      "artifactName": "Steam-Achiever-${version}.${ext}"
    },
    "publish": {
      "provider": "github",
      "releaseType": "release"
    }
  }
}
